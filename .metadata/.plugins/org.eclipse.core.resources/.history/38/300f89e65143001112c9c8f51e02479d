/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_USART1_UART_Init();
  MX_FDCAN2_Init();
  MX_TIM1_Init();
  MX_TIM2_Init();
  MX_TIM4_Init();
  MX_TIM3_Init();
  MX_TIM15_Init();
  MX_TIM8_Init();
  /* USER CODE BEGIN 2 */
  initUART();

  if (!Drive_Init(&hfdcan2, MCU_ADDRESS_DEFAULT)) {
	 Error_Handler();
  }

  HAL_TIM_IC_Start_IT(&htim3, TIM_CHANNEL_3); // throttle
  HAL_TIM_IC_Start_IT(&htim3, TIM_CHANNEL_4); // e-stop

  HAL_TIM_PWM_Start_IT(&htim8, TIM_CHANNEL_2); // brake

  Steering_Init(&htim1, &htim15);

  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1) {

	  loop_count++;

	  bool signal_ok = (g_last_pulse_ms > 0) && (HAL_GetTick() - g_last_pulse_ms < 100);
	  bool estopped  = !signal_ok || (g_estop_us > 1500);

	  //bool estopped = false;
	  //(void)g_estop_us; /* suppress unused-variable warning if signal_ok check is disabled */

	  //  E-stop or signal lost
	  if (estopped || Drive_GetState() == DRIVE_STATE_COMM_FAILED || Drive_HasError()) {
		  g_target_speed   = DRIVE_ENCODE_SPEED(0.0f);
		  g_target_current = DRIVE_ENCODE_CURRENT(0.0f);
		  g_command = CMD_HALTED;
		  HAL_Delay(10);
	  }

	  // ---- Normal operation ----
	  else if (Drive_GetState() == DRIVE_STATE_OPERATIONAL) {

		  // Map 1000-2000µs to -1000..+1000 rpm with ±50µs deadband
		  int32_t deviation = (int32_t)g_throttle_us - 1500;
		  int32_t target    = 0;

		  if (deviation > 50)
			  target = ((deviation - 50) * MAX_RPM) / 450;
		  else if (deviation < -50)
			  target = ((deviation + 50) * MAX_RPM) / 450;

		  if (target >  MAX_RPM) { target =  MAX_RPM; }
		  if (target < -MAX_RPM) { target = -MAX_RPM; }


		  if (target >= 0) {
			  g_target_speed   = DRIVE_ENCODE_SPEED((float)target);
			  g_target_current = DRIVE_ENCODE_CURRENT(50.0f);
		  } else {
			  g_target_speed   = DRIVE_ENCODE_SPEED((float)target);
			  g_target_current = DRIVE_ENCODE_CURRENT(-50.0f);
		  }

		  g_command        = CMD_RUNNING | CMD_SPEED_MODE;
	  }

	  Drive_Tick(g_target_current, g_target_speed, g_command);

	  //Steering
	  Steering_Tick();
	  test_pwm = Steering_GetPulseWidth();

	  if (estopped) {
	      Servo_WriteMicroseconds(SERVO_APPLIED_US);
	  } else {
	      Servo_WriteMicroseconds(SERVO_UPRIGHT_US);n
	  }


	  HAL_Delay(10);

  }
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */

  /* USER CODE END 3 */
}

